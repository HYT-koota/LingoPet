# Optional: test deployed preview/production URL.
# If omitted, Playwright will start local dev server at http://127.0.0.1:4173
E2E_BASE_URL=

# Required when login page appears during test.
E2E_EMAIL=your_test_account_email
E2E_PASSWORD=your_test_account_password

# Optional probe word for dictionary smoke test.
E2E_WORD=vector

